{
  "name": "rongcheng-admin",
  "version": "1.0.0",
  "description": "蓉城企服管理后台",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "menu:check": "node scripts/check-menu-roles.mjs",
    "regions:sync": "node scripts/sync-regions.cjs",
    "regions:check": "node scripts/check-region-alignment.cjs",
    "regions:check:cross-project": "node scripts/check-region-alignment.cjs --cross-project",
    "seals:check": "node scripts/check-seal-management.mjs",
    "quality": "npm run typecheck && npm run lint && npm run test:coverage && npm run menu:check && npm run regions:check && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.6.7",
    "dayjs": "^1.11.10",
    "echarts": "6.1.0",
    "element-plus": "^2.6.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "http-proxy": "^1.18.1",
    "sass": "^1.71.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "8.70.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.3.1",
    "@vitest/coverage-istanbul": "^5.0.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^2.0.6"
  }
}
